# Ignore compiled binaries
scheduler
scheduler.exe

# Ignore build artifacts
*.o
*.out

# Ignore logs and generated CSV files in logs/
logs/
!logs/*.md     # allow any markdown notes in logs
!logs/*.txt    # allow input text files if placed there (optional)

# Ignore CSVs everywhere except data/ folder
*.csv
!data/*.csv

# Ignore temporary or backup files
*~
*.tmp

# Ignore OS-specific junk
.DS_Store
Thumbs.db
